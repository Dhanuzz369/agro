---
// Served by Vercel (and astro preview) for any unknown path. English only, never indexed.
import Base from '../layouts/Base.astro';
---
<Base locale="en" title="Page not found" description="This page does not exist. Browse GoodBiz Agri products or request a quote." path="/404" available={['en']} noindex>
  <div class="container nf">
    <p class="eyebrow">404</p>
    <h1>We could not find that page</h1>
    <p>The link may be old or mistyped. These will get you back on track:</p>
    <ul class="nf__links">
      <li><a class="btn btn--primary" href="/contact" title="Request an export price quote from GoodBiz Agri">Request a quote</a></li>
      <li><a class="btn btn--secondary" href="/products" title="Agro products we export from India">View products</a></li>
      <li><a class="btn btn--ghost" href="/" title="GoodBiz Agri: agro products exporter from India">Home</a></li>
    </ul>
  </div>
</Base>
<style>
  .nf { padding-block: calc(var(--header-offset) + var(--space-7)) var(--space-8); display: grid; gap: var(--space-4); justify-items: start; }
  .nf__links { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
</style>
