---
// no-JS form redirect target (noindex)
import Base from '../layouts/Base.astro';
import { createT } from '../i18n/t';
const t = createT('en');
---
<Base locale="en" title={t('form.success.title')} description={t('form.success.body')} path="/thanks" available={['en']} noindex>
  <div class="container" style="padding-block: calc(var(--header-offset) + var(--space-7)) var(--space-8); display: grid; gap: var(--space-4);">
    <h1>{t('form.success.title')}</h1><p>{t('form.success.body')}</p>
    <a class="btn btn--primary" href="/products" title={t('link.products')}>{t('cta.viewProducts')}</a>
  </div>
</Base>
