---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { createT } from '../i18n/t';
import { breadcrumbLd } from '../lib/jsonld';
import { localizePath } from '../i18n/paths';
import { htmlLang, type Locale } from '../i18n/config';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = createT(locale);
const entry = (await getEntry('legal', `${locale}/privacy`))!;
const { Content } = await render(entry);
const { title, description, updated } = entry.data;
const crumbs = [{ name: t('nav.home'), path: '/' }, { name: title, path: '/privacy' }];
const abs = (p: string) => new URL(localizePath(p, locale), Astro.site).href;
const date = new Intl.DateTimeFormat(htmlLang[locale], { dateStyle: 'long', timeZone: 'UTC' }).format(updated);
---
<Base locale={locale} title={`${title} | GoodBiz Agri`} description={description} path="/privacy" modified={updated}
  jsonLd={[breadcrumbLd(crumbs.map((c) => ({ name: c.name, url: abs(c.path) })))]}>
  <article class="container pp">
    <Breadcrumbs locale={locale} items={crumbs} />
    <header>
      <h1>{title}</h1>
      <p class="pp__meta"><time datetime={updated.toISOString().slice(0, 10)}>{t('product.updated', { date })}</time></p>
    </header>
    <div class="pp__body"><Content /></div>
  </article>
</Base>
<style>
  .pp { padding-block: var(--header-offset) var(--space-8); display: grid; gap: var(--space-6); max-inline-size: 48rem; }
  .pp header { display: grid; gap: var(--space-3); }
  .pp__meta { font-size: var(--step--1); color: var(--ink-2); }
  .pp__body { display: grid; gap: var(--space-4); font-size: var(--step-0); line-height: 1.6; }
  .pp__body :global(h2) { font-size: var(--step-2); margin-block-start: var(--space-5); }
  .pp__body :global(ul) { display: grid; gap: var(--space-2); padding-inline-start: 1.25em; margin: 0; }
  .pp__body :global(p) { margin: 0; }
  /* The cookie table scrolls on its own on a phone instead of widening the page */
  .pp__body :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: var(--step--1); }
  .pp__body :global(th), .pp__body :global(td) { text-align: start; vertical-align: top; padding: var(--space-2) var(--space-3); border-block-end: 1px solid var(--rule); }
  .pp__body :global(td:first-child) { white-space: nowrap; }
  .pp__body :global(code) { font-family: var(--font-mono); font-size: 0.92em; }
  .pp__body :global(.pp__btn) { min-block-size: 44px; padding: 0; border: 0; background: none; color: inherit; font: inherit; font-weight: 600;
    text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }
</style>
