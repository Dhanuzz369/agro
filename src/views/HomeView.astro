---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import CertStrip from '../components/CertStrip.astro';
import Range from '../components/home/Range.astro';
import Journey from '../components/home/Journey.astro';
import Why from '../components/home/Why.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import World from '../components/home/World.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { createT } from '../i18n/t';
import { homeFaq } from '../i18n/home-faq';
import { faqLd, itemListLd } from '../lib/jsonld';
import { getLocalizedProducts } from '../lib/catalog';
import { localizePath } from '../i18n/paths';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = createT(locale);
const products = await getLocalizedProducts(locale);
const abs = (p: string) => new URL(localizePath(p, locale), Astro.site).href;
// The home page lists the products, so it changed when the newest product page did.
const lastUpdated = new Date(Math.max(...products.map((p) => p.data.updated.getTime())));
const ld = [
  itemListLd({ id: `${abs('/')}#list`, name: t('products.title'), items: products.map((p) => ({ name: p.text.name, url: abs(`/products/${p.slug}`) })) }),
  faqLd(homeFaq(locale)),
];
---
<Base locale={locale} title={t('meta.homeTitle')} description={t('meta.homeDescription')} keywords={t('meta.homeKeywords')} path="/" ogImage="/og/home.png" jsonLd={ld} modified={lastUpdated}>
  <Hero locale={locale} />
  <CertStrip locale={locale} />
  <Range locale={locale} />
  <Journey locale={locale} />
  <Why locale={locale} />
  <HomeFaq locale={locale} />
  <World locale={locale} />
  <FinalCta locale={locale} />
</Base>
