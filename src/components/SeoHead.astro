---
import { alternates, localizePath } from '../i18n/paths';
import { ogLocale, htmlLang, type Locale, locales } from '../i18n/config';
import { webPageLd, websiteLd } from '../lib/jsonld';
import { createT } from '../i18n/t';

interface Props {
  locale: Locale; title: string; description: string; path: string;
  available?: readonly Locale[]; ogImage?: string; ogImageAlt?: string; ogType?: 'website' | 'article';
  keywords?: readonly string[] | string; jsonLd?: object[]; noindex?: boolean; modified?: Date;
}
const { locale, title, description, path, available = locales, ogImage, ogImageAlt, ogType = 'website', keywords, jsonLd = [], noindex = false, modified } = Astro.props;
const site = Astro.site!;
const canonical = new URL(localizePath(path, locale), site).href;
const og = new URL(ogImage ?? '/og/home.png', site).href;
// Primary keyword first, brand last.
const fullTitle = title.includes('GoodBiz') ? title : `${title} | GoodBiz Agri`;
const kw = typeof keywords === 'string' ? keywords : keywords?.join(', ');
const alt = ogImageAlt ?? title;
// Every indexable page describes itself as a WebPage that links to the other blocks on it by @id.
const ids = jsonLd.map((d) => (d as { '@id'?: string })['@id'] ?? '');
const pageType = path === '/about' ? 'AboutPage' : path === '/contact' ? 'ContactPage' : path === '/products' || path === '/blog' ? 'CollectionPage' : 'WebPage';
const homeUrl = new URL(localizePath('/', locale), site).href;
// The site node rides on every page, so each page's WebPage.isPartOf resolves on the page itself.
const siteNode = websiteLd({ siteUrl: site.href, url: homeUrl, name: 'GoodBiz Agri', description: createT(locale)('meta.homeDescription'), inLanguage: htmlLang[locale] });
const page = noindex ? [] : [siteNode, webPageLd({
  type: pageType, url: canonical, name: fullTitle, description, inLanguage: htmlLang[locale], siteUrl: site.href,
  websiteUrl: homeUrl,
  breadcrumb: ids.some((i) => i === `${canonical}#breadcrumb`),
  mainEntity: ids.find((i) => i.endsWith('#product') || i.endsWith('#article') || i.endsWith('#list')),
  dateModified: modified,
})];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="GoodBiz Agri" />
{kw && <meta name="keywords" content={kw} />}
<meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<link rel="canonical" href={canonical} />
{!noindex && alternates(path, available).map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.path, site).href} />)}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="GoodBiz Agri" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={alt} />
<meta property="og:locale" content={ogLocale[locale]} />
{available.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<meta name="twitter:image:alt" content={alt} />
<link rel="alternate" type="application/rss+xml" title="GoodBiz Agri" href={localizePath('/rss.xml', locale)} />
{[...page, ...jsonLd].map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
