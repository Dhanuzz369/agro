---
// src/components/SouthIndiaMap.astro
import { places, type PlaceId } from '../data/places';
import { projectSouth, southIndiaOutline } from '../lib/geo';
import { placeLabels } from '../lib/map-labels';
import { getLocalizedProducts } from '../lib/catalog';
interface Props {
  /** districts and ports whose dots and labels are highlighted; the HQ is always labelled */
  active?: PlaceId[];
  label: string;
  interactiveId?: string;
  /** 'hubs' labels only the HQ and ports (for the all-districts network view) */
  labels?: 'active' | 'hubs';
}
const { active = [], label, interactiveId, labels = 'active' } = Astro.props;
const W = 600, H = 700;
const outline = southIndiaOutline(W, H);
const pts = (Object.keys(places) as PlaceId[]).map((id) => {
  const p = places[id];
  const [x, y] = projectSouth(W, H, [p.lon, p.lat]);
  return { id, x, y, label: p.name, ...p };
});
// labels that can be on screen together: one set per product (HQ + its ports + its districts), plus the hubs view
const products = await getLocalizedProducts('en');
const hubs: PlaceId[] = pts.filter((p) => p.kind !== 'district').map((p) => p.id);
const groups = [hubs, ...products.map((p) => ['bengaluru', ...p.data.ports, ...p.data.regions])];
const placed = placeLabels(pts, { width: W, height: H }, groups);
const isActive = (id: PlaceId) => active.includes(id);
---
<div class="simw" data-labels={labels}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label} class="sim" data-map={interactiveId}>
    <path d={outline} class="sim__land" />
    {pts.map((p) => (
      <g data-place={p.id} data-kind={p.kind} data-active={String(isActive(p.id))} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`}>
        <circle r={p.kind === 'district' ? 6 : 5} />
        <text x={placed[p.id].dx} dy={placed[p.id].dy} text-anchor={placed[p.id].anchor}>{p.name}</text>
      </g>
    ))}
  </svg>
  <ul class="simw__legend" aria-hidden="true">
    {pts.map((p) => <li data-legend={p.id} data-kind={p.kind} data-active={String(isActive(p.id))}>{p.name}</li>)}
  </ul>
</div>
<style>
  .simw { container-type: inline-size; }
  .sim { display: block; inline-size: 100%; block-size: auto; }
  .sim__land { fill: var(--paper-2); stroke: var(--ink); stroke-width: 0.8; }
  g circle { fill: var(--paper); stroke: var(--ink-2); stroke-width: 1; transition: fill var(--dur-1) var(--ease), r var(--dur-1) var(--ease); }
  /* label size is in viewBox units: steps keep it at 12px or more on screen; positions are planned for the largest step */
  g text { font-family: var(--font-body); font-size: 13px; fill: var(--ink-2); opacity: 0; transition: opacity var(--dur-1) var(--ease); direction: ltr; paint-order: stroke; stroke: var(--paper); stroke-width: 3px; stroke-linejoin: round; }
  @container (max-width: 559px) { g text { font-size: 15px; } }
  @container (max-width: 479px) { g text { font-size: 18px; } }
  g[data-kind='district'][data-active='true'] circle { fill: var(--clay); stroke: var(--paper); r: 9; }
  g[data-active='true'] text, g[data-kind='hq'] text { opacity: 1; }
  .simw[data-labels='hubs'] g[data-kind='port'] text { opacity: 1; }
  .simw[data-labels='hubs'] g[data-kind='district'] text { opacity: 0; }
  g[data-kind='hq'] circle { fill: var(--forest); r: 8; }
  g[data-kind='port'] circle { fill: var(--clay); stroke: none; }

  /* below 400px the map is too small for 12px labels inside it: list the visible places underneath instead */
  .simw__legend { display: none; list-style: none; margin: var(--space-3) 0 0; padding: 0; flex-wrap: wrap; gap: var(--space-1) var(--space-4); font-size: var(--step--1); color: var(--ink-2); }
  .simw__legend li { display: none; align-items: center; gap: var(--space-2); }
  .simw__legend li::before { content: ''; inline-size: 0.6rem; block-size: 0.6rem; border-radius: 999px; background: var(--clay); }
  .simw__legend li[data-kind='hq']::before { background: var(--forest); }
  .simw__legend li[data-kind='port']::before { inline-size: 0.45rem; block-size: 0.45rem; }
  .simw__legend li[data-kind='hq'], .simw__legend li[data-active='true'] { display: inline-flex; }
  .simw[data-labels='hubs'] .simw__legend li[data-kind='port'] { display: inline-flex; }
  .simw[data-labels='hubs'] .simw__legend li[data-kind='district'] { display: none; }
  @container (max-width: 399px) {
    g text { display: none; }
    .simw__legend { display: flex; }
  }
</style>
