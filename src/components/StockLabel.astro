---
import { createT } from '../i18n/t';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; show: boolean }
const { locale, show } = Astro.props;
---
{show && <span class="stock">{createT(locale)('product.representative')}</span>}
<style>
  .stock { position: absolute; inset-block-end: var(--space-2); inset-inline-start: var(--space-2); font-size: var(--step--2);
    background: rgb(28 27 26 / 0.8); color: var(--paper); padding: 0.2em 0.6em; border-radius: 999px; transition: opacity var(--dur-1) var(--ease); }
</style>
