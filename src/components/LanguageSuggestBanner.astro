---
import { createT } from '../i18n/t';
import { localizePath } from '../i18n/paths';
import { locales, type Locale } from '../i18n/config';
interface Props { locale: Locale; path: string; available?: readonly Locale[] }
const { locale, path, available = locales } = Astro.props;
const strings = Object.fromEntries(available.map((l) => {
  const t = createT(l);
  return [l, { text: t('lang.suggestion'), yes: t('lang.suggestYes'), no: t('lang.dismiss') }];
}));
---
<div class="lsb" data-lang-suggest hidden data-current={locale} data-available={JSON.stringify(available)} data-strings={JSON.stringify(strings)} role="region" aria-live="polite">
  <p data-text></p>
  {/* real href until the script points it at the suggested language: crawlable, never a dead "#" */}
  <a class="btn btn--secondary" data-yes href={localizePath(path, locale)}></a>
  <button type="button" class="btn btn--ghost lsb__no" data-dismiss>
    <span data-no-text></span>
    <svg class="lsb__x" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
  </button>
</div>
<script>
  import { suggestLocale, safeStorage } from '../lib/lang-switch';
  import { localizePath, stripLocale } from '../i18n/paths';
  import type { Locale } from '../i18n/config';
  const el = document.querySelector<HTMLElement>('[data-lang-suggest]');
  if (el && !safeStorage.get('gb.suggest.dismissed') && !safeStorage.get('gb.lang')) {
    const available: Locale[] = JSON.parse(el.dataset.available!);
    const target = suggestLocale(navigator.languages ?? [navigator.language], el.dataset.current as Locale, available);
    if (target) {
      const s = JSON.parse(el.dataset.strings!)[target];
      el.lang = target;
      el.dir = target === 'ar' ? 'rtl' : 'ltr';
      el.querySelector('[data-text]')!.textContent = s.text;
      const yes = el.querySelector<HTMLAnchorElement>('[data-yes]')!;
      yes.textContent = s.yes;
      yes.href = localizePath(stripLocale(location.pathname).path, target);
      yes.addEventListener('click', () => safeStorage.set('gb.lang', target));
      const no = el.querySelector<HTMLButtonElement>('[data-dismiss]')!;
      no.querySelector('[data-no-text]')!.textContent = s.no;
      no.addEventListener('click', () => { safeStorage.set('gb.suggest.dismissed', '1'); el.hidden = true; });
      el.hidden = false;
    }
  }
</script>
<style>
  /* sits above the floating language and WhatsApp buttons instead of covering the header navigation */
  .lsb { position: fixed; inset-block-end: calc(var(--space-4) + 4.5rem); inset-inline: var(--space-4); z-index: 50; margin-inline: auto; max-inline-size: 36rem;
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); padding: var(--space-4); background: var(--paper); color: var(--ink);
    box-shadow: var(--shadow-2); border-radius: var(--radius-card); }
  .lsb[hidden] { display: none; }
  .lsb p { flex: 1 1 12rem; font-weight: 500; }
  .lsb__x { display: none; }
  /* phones: one compact row docked at the very bottom, so it stays clear of the hero CTAs
     (hero keeps 72px below them); the floating language and WhatsApp buttons hide while it shows —
     lifted, they covered the secondary hero CTA, and the banner itself offers the language choice */
  @media (max-width: 480px) {
    .lsb { inset-block-end: 0; inset-inline: 0; max-inline-size: none; flex-wrap: nowrap; gap: var(--space-2);
      padding: var(--space-2) var(--space-2) calc(var(--space-2) + env(safe-area-inset-bottom)) var(--space-4); border-radius: var(--radius-card) var(--radius-card) 0 0; }
    .lsb p { flex: 1 1 auto; min-inline-size: 0; font-size: var(--step--1); line-height: 1.3; }
    .lsb .btn { inline-size: auto; min-block-size: 44px; padding-inline: var(--space-4); font-size: var(--step--1); white-space: nowrap; }
    .lsb .lsb__no { inline-size: 44px; padding: 0; border-color: transparent; }
    .lsb__no [data-no-text] { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .lsb__x { display: block; }
    :global(body:has(.lsb:not([hidden])) .wa), :global(body:has(.lsb:not([hidden])) .ls__pill) { display: none; }
  }
</style>
