---
// src/components/WorldMap.astro
import { routeHubs } from '../data/countries';
import { worldArcs, projectWorld } from '../lib/geo';
import { places } from '../data/places';
import { WORLD_W as W, WORLD_H as H } from '../lib/world-map-size';
interface Props { label: string }
const { label } = Astro.props;
const origin: [number, number] = [places.bengaluru.lon, places.bengaluru.lat];
const arcs = worldArcs(W, H, origin, routeHubs.map((h) => [h.lon, h.lat]));
const [ox, oy] = projectWorld(W, H, origin);
const hubs = routeHubs.map((h) => ({ ...h, xy: projectWorld(W, H, [h.lon, h.lat]) }));
---
<div class="wm">
  <img src="/maps/world.svg" alt={label} title={label} width={W} height={H} loading="lazy" decoding="async" class="wm__land" />
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false" class="wm__routes">
    {arcs.map((d) => <path d={d} class="wm__arc" data-draw />)}
    {hubs.map((h) => <circle cx={h.xy[0]} cy={h.xy[1]} r="3.5" class="wm__hub" />)}
    <circle cx={ox} cy={oy} r="7" class="wm__origin" />
  </svg>
</div>
<style>
  .wm { position: relative; inline-size: 100%; aspect-ratio: 1000 / 520; }
  .wm__land, .wm__routes { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }
  .wm__arc { fill: none; stroke: var(--gold-soft); stroke-width: 1.2; stroke-linecap: round; }
  .wm__hub { fill: var(--gold-soft); }
  .wm__origin { fill: var(--gold-soft); stroke: var(--paper); stroke-width: 2; }
</style>
