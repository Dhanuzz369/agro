---
import { createT } from '../i18n/t';
import { localizePath } from '../i18n/paths';
import { getSite, getLocalizedProducts } from '../lib/catalog';
import { mailtoHref, isPlaceholder } from '../lib/site';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = createT(locale);
const site = await getSite();
const mail = mailtoHref(site.email);
const products = await getLocalizedProducts(locale);
---
<footer class="ftr" data-tone="dark">
  <div class="container ftr__grid">
    <div>
      <p class="ftr__brand">GoodBiz <span>Agri</span></p>
      <p>{t('footer.tagline')}</p>
      <address>
        {!isPlaceholder(site.address.street) && <>{site.address.street}<br /></>}{site.address.city}, {site.address.region}{!isPlaceholder(site.address.postalCode) && ` ${site.address.postalCode}`}<br />India
      </address>
      <p class="ftr__contact">
        {mail && <a href={mail} title={t('link.email')}>{site.email}</a>}
        {!isPlaceholder(site.phone) && <a href={`tel:${site.phone.replace(/\s/g, '')}`} dir="ltr" title={t('link.phone')}>{site.phone}</a>}
      </p>
    </div>
    <nav aria-labelledby="ftr-products">
      <h2 id="ftr-products" class="eyebrow">{t('nav.products')}</h2>
      <ul class="ftr__list">
        {products.map((p) => <li><a href={localizePath(`/products/${p.slug}`, locale)} title={p.text.seo.title}>{p.text.name}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container ftr__base"><p>{t('footer.rights', { year: new Date().getFullYear() })}</p></div>
</footer>
<style>
  .ftr { background: var(--forest); color: var(--paper); padding-block: var(--space-8) var(--space-6); }
  .ftr .eyebrow { color: var(--gold-soft); }
  .ftr__grid { display: grid; gap: var(--space-7); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .ftr__brand { font-family: var(--font-display); font-size: var(--step-2); }
  .ftr__brand span { color: var(--turmeric); }
  .ftr__contact { display: grid; justify-items: start; margin: 0; }
  /* Footer links get 44px touch targets; the min height replaces the old item padding */
  .ftr__contact a, .ftr__list a { display: inline-flex; align-items: center; min-block-size: 44px; }
  address { font-style: normal; margin-block: var(--space-4); opacity: 0.85; }
  .ftr__list { list-style: none; padding: 0; margin: var(--space-4) 0 0; columns: 2 14rem; font-size: var(--step--1); }
  .ftr__list li { break-inside: avoid; }
  .ftr__base { margin-block-start: var(--space-7); padding-block-start: var(--space-5); border-block-start: 1px solid rgb(246 241 231 / 0.2); font-size: var(--step--1); opacity: 0.8; }
</style>
