---
// Framed hero: the headline sits in the middle of an 8 × 5 grid and product photos fill the ring around it
// (after glideapps.com/customers, with bigger photos). Every photo links to its product page.
// Below 1024px the frame becomes a strip of photos above the headline and two rows below it.
import { Image } from 'astro:assets';
import { createT } from '../../i18n/t';
import { localizePath } from '../../i18n/paths';
import { getLocalizedProducts, getSite } from '../../lib/catalog';
import type { Locale } from '../../i18n/config';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = createT(locale);
const [products, site] = await Promise.all([getLocalizedProducts(locale), getSite()]);

// The ring of an 8 × 5 grid, row by row: the middle four columns of rows 2–4 are left for the text.
const COLS = 8, ROWS = 5;
const ring: { r: number; c: number }[] = [];
for (let r = 1; r <= ROWS; r++)
  for (let c = 1; c <= COLS; c++)
    if (r === 1 || r === ROWS || c <= 2 || c > COLS - 2) ring.push({ r, c });

// Hero shot of every product first, then their varieties, dealt round-robin so neighbours differ.
const pool = products.map((p) => [
  { src: p.data.heroImage.src, alt: t('alt.product', { name: p.text.name, origin: p.text.originLine }), name: p.text.name, slug: p.slug },
  ...p.data.varieties.map((v) => {
    const name = p.text.varieties[v.id]?.name ?? v.id;
    return { src: v.image.src, alt: t('alt.variety', { variety: name, name: p.text.name }), name, slug: p.slug };
  }),
]);
const photos: (typeof pool)[number] = [];
for (let round = 0; photos.length < ring.length && round < 20; round++)
  for (const list of pool) if (list[round] && photos.length < ring.length) photos.push(list[round]);
// A loose rhythm of portrait and landscape frames, like contact prints laid on a table.
const landscape = (i: number) => [3, 6, 11, 17, 21, 22].includes(i);
---
<section class="frame" aria-labelledby="hero-title">
  <div class="frame__text">
    <p class="frame__label">{t('hero.label', { n: site.stats.countries })}</p>
    <h1 id="hero-title" class="frame__title">{t('hero.title')}</h1>
    <p class="frame__lede">{t('hero.lede')}</p>
    <div class="frame__ctas">
      <a class="btn btn--primary" href={localizePath('/contact', locale)}>{t('hero.quote')}</a>
      <a class="btn btn--ghost" href={localizePath('/products', locale)}>{t('hero.products')}</a>
    </div>
  </div>
  {photos.map((p, i) => (
    <a class:list={['frame__photo', { 'frame__photo--wide': landscape(i) }]} href={localizePath(`/products/${p.slug}`, locale)}
      style={`--r:${ring[i].r};--c:${ring[i].c};--i:${i}`} data-hero-photo>
      <Image src={p.src} alt={p.alt} widths={[160, 240, 320]} sizes="(min-width: 1024px) 10vw, 25vw" quality={60} format="webp" loading="lazy" decoding="async" />
      <span class="frame__cap" aria-hidden="true">{p.name}</span>
    </a>
  ))}
</section>
<style>
  .frame {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4) var(--space-3);
    padding: calc(var(--header-offset) - var(--space-4)) var(--gutter) var(--space-8); background: var(--paper);
    overflow-x: clip; /* hidden name tags on edge photos must not widen the page */
  }

  .frame__text { grid-column: 1 / -1; order: 1; display: grid; justify-items: center; gap: var(--space-5); padding-block: var(--space-6); text-align: center; }
  .frame__label { margin: 0; font-size: var(--step--2); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); }
  .frame__title { margin: 0; max-inline-size: 13ch; font-family: var(--font-display); font-weight: 300; font-size: clamp(2.75rem, 4.6vw + 1rem, 5.25rem);
    line-height: 1; letter-spacing: -0.03em; text-wrap: balance; color: var(--ink); }
  .frame__lede { margin: 0; max-inline-size: 34rem; font-size: var(--step-0); line-height: 1.5; color: var(--ink-2); text-wrap: pretty; }
  .frame__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-block-start: var(--space-2); }
  :global(:root:is(:lang(ar), :lang(zh))) .frame__label { letter-spacing: 0; font-size: var(--step--1); }
  :global(:root:is(:lang(ar), :lang(zh))) .frame__title { line-height: 1.2; letter-spacing: 0; }

  /* Photos: phones show four above the headline and eight below; the rest of the ring is for wider screens */
  .frame__photo { position: relative; display: grid; place-items: center; order: 2; text-decoration: none; color: var(--ink); }
  .frame__photo:nth-of-type(-n + 4) { order: 0; }
  .frame__photo:nth-of-type(n + 13) { display: none; }
  .frame__photo :global(img) {
    inline-size: 100%; aspect-ratio: 3 / 4; block-size: auto; object-fit: cover; border-radius: 6px; background: var(--paper-2);
    transition: transform 220ms var(--ease-out);
  }
  .frame__photo--wide :global(img) { aspect-ratio: 4 / 3; }

  /* Name on hover (real pointers only), so a buyer can tell Salem bulb from Alleppey finger */
  .frame__cap {
    position: absolute; inset-block-start: calc(100% + 0.35rem); inset-inline-start: 50%; translate: -50% 0; z-index: 1;
    padding: 0.2rem 0.55rem; border-radius: 999px; background: var(--ink); color: var(--paper);
    font-size: 0.75rem; font-weight: 500; white-space: nowrap; pointer-events: none;
    opacity: 0; transform: translateY(-4px); transition: opacity 150ms ease, transform 150ms var(--ease-out);
  }
  :global([dir='rtl']) .frame__cap { translate: 50% 0; }
  @media (hover: hover) and (pointer: fine) {
    .frame__photo:hover :global(img) { transform: scale(1.04); }
    .frame__photo:hover .frame__cap { opacity: 1; transform: none; }
  }
  .frame__photo:focus-visible { outline: none; }
  .frame__photo:focus-visible :global(img) { outline: 2px solid var(--ink); outline-offset: 3px; }
  .frame__photo:focus-visible .frame__cap { opacity: 1; transform: none; }
  .frame__photo:active :global(img) { transform: scale(0.97); }

  /* Photos settle in one after another on load: decorative, quick, never blocking the text */
  @media (prefers-reduced-motion: no-preference) {
    .frame__photo { animation: frame-in 520ms var(--ease-out) both; animation-delay: calc(var(--i) * 35ms + 120ms); }
    @keyframes frame-in { from { opacity: 0; transform: translateY(10px) scale(0.96); } }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .frame { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .frame__photo:nth-of-type(-n + 6) { order: 0; }
    .frame__photo:nth-of-type(n + 13) { display: grid; }
    .frame__photo:nth-of-type(n + 19) { display: none; }
  }

  /* Desktop: the full ring around the text, one viewport tall */
  @media (min-width: 1024px) {
    .frame {
      grid-template-columns: repeat(8, minmax(0, 1fr)); grid-template-rows: repeat(5, minmax(0, 1fr));
      min-block-size: max(100svh, 46rem); gap: 0; padding: 5.5rem clamp(var(--space-5), 3vw, var(--space-7)) var(--space-6);
    }
    .frame__text { grid-column: 3 / 7; grid-row: 2 / 5; align-content: center; padding: 0; }
    .frame__photo, .frame__photo:nth-of-type(n) { display: grid; order: 0; grid-row: var(--r); grid-column: var(--c); }
    /* Bigger than the reference: ~104 px portraits and ~140 px landscapes at 1440 wide */
    .frame__photo :global(img) { inline-size: clamp(4.5rem, 7.2vw, 7.5rem); }
    .frame__photo--wide :global(img) { inline-size: clamp(6rem, 9.7vw, 10rem); }
  }
</style>
