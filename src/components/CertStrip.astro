---
import { createT } from '../i18n/t';
import { getSite } from '../lib/catalog';
import { isPlaceholder } from '../lib/site';
import sharp from 'sharp';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = createT(locale);
const site = await getSite();
const held = site.registrations.filter((r) => r.held);
// Intrinsic width at the rendered 56px height, so the browser reserves the space (no layout shift).
const regs = await Promise.all(held.map(async (r) => {
  if (!r.logo) return { ...r, width: undefined };
  const m = await sharp(`public${r.logo}`).metadata();
  return { ...r, width: m.width && m.height ? Math.round((m.width / m.height) * 56) : undefined };
}));
---
<section class="certs" aria-labelledby="certs-title">
  <div class="container certs__inner">
    <h2 id="certs-title" class="eyebrow">{t('trust.title')}</h2>
    <ul>
      {regs.map((r) => (
        <li data-reg={r.id}>
          <span class="certs__tile">
            {r.logo
              ? <img src={r.logo} alt={t('alt.registration', { name: r.name })} title={t('alt.registration', { name: r.name })} width={r.width} height="56" loading="lazy" decoding="async" />
              : <strong class="certs__mark">{r.name}</strong>}
          </span>
          <span class="certs__name">{r.name}</span>
          {!isPlaceholder(r.number) && <span class="certs__no" dir="ltr">{t('trust.regNo')} {r.number}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .certs { border-block: 1px solid var(--rule); padding-block: var(--space-7); }
  .certs__inner { display: grid; gap: var(--space-6); justify-items: center; text-align: center; }
  .certs__inner > ul { inline-size: 100%; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-7) var(--space-5); }
  li { display: grid; justify-items: center; align-content: start; gap: var(--space-3); text-align: center; }
  /* Every logo sits in the same-height box and is scaled to the same height, so the row reads evenly */
  .certs__tile { display: grid; place-items: center; block-size: 64px; inline-size: 100%; }
  .certs__tile img { block-size: 56px; inline-size: auto; max-inline-size: 100%; object-fit: contain; }
  .certs__mark { font-family: var(--font-display); font-weight: 500; font-size: var(--step-2); color: var(--forest); letter-spacing: 0.02em; }
  .certs__name { font-weight: 500; font-size: var(--step--1); }
  .certs__no { font-size: var(--step--1); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  /* Desktop: one row of six equal columns, each logo centred in its column */
  @media (min-width: 1100px) {
    ul { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-5); }
  }
  @media (max-width: 767px) {
    .certs__inner { justify-items: center; text-align: center; }
    ul { grid-template-columns: minmax(0, 1fr); inline-size: 100%; }
  }
</style>
