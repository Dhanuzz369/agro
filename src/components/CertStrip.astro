---
import { createT } from '../i18n/t';
import { getSite } from '../lib/catalog';
import { isPlaceholder } from '../lib/site';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = createT(locale);
const site = await getSite();
const regs = site.registrations.filter((r) => r.held);
---
<section class="certs" aria-labelledby="certs-title">
  <div class="container certs__inner">
    <h2 id="certs-title" class="eyebrow">{t('trust.title')}</h2>
    <ul>
      {regs.map((r) => (
        <li data-reg={r.id}>
          <span class="certs__tile">
            {r.logo
              ? <img src={r.logo} alt={r.name} height="56" loading="lazy" decoding="async" />
              : <strong class="certs__mark">{r.name}</strong>}
          </span>
          <span class="certs__name">{r.name}</span>
          {!isPlaceholder(r.number) && <span class="certs__no" dir="ltr">{t('trust.regNo')} {r.number}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .certs { border-block: 1px solid var(--rule); padding-block: var(--space-6); }
  .certs__inner { display: grid; gap: var(--space-5); }
  ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr)); gap: var(--space-5); list-style: none; margin: 0; padding: 0; }
  li { display: grid; gap: var(--space-2); align-content: start; }
  .certs__tile { display: grid; place-items: center start; block-size: 72px; }
  .certs__tile img { max-block-size: 64px; max-inline-size: 100%; inline-size: auto; object-fit: contain; }
  .certs__mark { font-family: var(--font-display); font-weight: 500; font-size: var(--step-2); color: var(--forest); letter-spacing: 0.02em; }
  .certs__name { font-weight: 500; font-size: var(--step--1); }
  .certs__no { font-size: var(--step--1); color: var(--ink-2); font-variant-numeric: tabular-nums; }
  @media (max-width: 767px) {
    .certs__inner { justify-items: center; text-align: center; }
    ul { justify-items: center; inline-size: 100%; }
    li { justify-items: center; }
    .certs__tile { place-items: center; }
  }
</style>
