---
import { createT } from '../i18n/t';
import { localizePath } from '../i18n/paths';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const t = createT(locale);
const links = [
  { href: '/products', label: t('nav.products'), title: t('link.products') },
  { href: '/about', label: t('nav.about'), title: t('link.about') },
  { href: '/blog', label: t('nav.blog'), title: t('link.blog') },
  { href: '/contact', label: t('nav.contact'), title: t('link.contact') },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="hdr" data-hdr>
  <div class="container hdr__row">
    <a class="brand" href={localizePath('/', locale)} title={t('link.home')}>GoodBiz <span>Agri</span></a>
    <nav aria-label="Main" class="hdr__nav" id="main-nav">
      <ul>
        {links.map((l) => <li><a href={localizePath(l.href, locale)} title={l.title} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
      <a class="btn btn--ghost" href={localizePath('/contact', locale)} title={t('link.quote')}>{t('cta.quote')}</a>
    </nav>
    <button class="hdr__toggle" aria-expanded="false" aria-controls="main-nav" data-open={t('nav.menu')} data-close={t('nav.close')}>{t('nav.menu')}</button>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.hdr__toggle');
  const setOpen = (open: boolean) => {
    if (!btn) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? btn.dataset.close! : btn.dataset.open!;
    document.documentElement.classList.toggle('nav-open', open);
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
  });
  document.querySelectorAll('#main-nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Keep the bar on screen and shrink it once the page has scrolled.
  const hdr = document.querySelector<HTMLElement>('[data-hdr]');
  let ticking = false;
  const update = () => { hdr?.toggleAttribute('data-scrolled', window.scrollY > 24); ticking = false; };
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  update();
</script>
<style>
  .hdr { position: fixed; inset-inline: 0; inset-block-start: 0; z-index: 30; padding-block: var(--space-4); background-color: rgb(247 241 232 / 0);
    transition: padding-block 0.35s var(--ease), background-color 0.35s var(--ease), box-shadow 0.35s var(--ease); }
  .hdr[data-scrolled] { padding-block: var(--space-2); background-color: rgb(247 241 232 / 0.97); box-shadow: 0 1px 0 var(--rule), 0 8px 24px rgb(26 26 23 / 0.06); }
  .brand { display: inline-block; transform-origin: left center; transition: transform 0.35s var(--ease); }
  .hdr[data-scrolled] .brand { transform: scale(0.86); }
  :global([dir='rtl']) .brand { transform-origin: right center; }
  .hdr .btn { transition: min-block-size 0.35s var(--ease), padding 0.35s var(--ease), background-color var(--dur-1) var(--ease); }
  .hdr[data-scrolled] .btn { min-block-size: 38px; padding-inline: var(--space-4); }
  .hdr[data-scrolled] .hdr__toggle { min-block-size: 38px; }
  .hdr__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); }
  .brand { font-family: var(--font-display); font-size: var(--step-1); text-decoration: none; }
  @media (prefers-reduced-motion: reduce) { .hdr, .brand, .hdr .btn { transition: none; } }
  .brand span { color: var(--clay); }
  .hdr__nav { display: flex; align-items: center; gap: var(--space-6); }
  .hdr__nav ul { display: flex; gap: var(--space-5); list-style: none; margin: 0; padding: 0; }
  .hdr__nav a:not(.btn) { text-decoration: none; }
  .hdr__nav a[aria-current='page'] { text-decoration: underline; }
  .hdr__toggle { display: none; min-block-size: 44px; background: none; border: 1px solid currentColor; color: inherit; border-radius: 999px; padding-inline: var(--space-4); font: inherit; }
  @media (max-width: 860px) {
    .hdr__toggle { display: inline-flex; align-items: center; }
    .hdr__nav { position: fixed; inset: 0; background: var(--forest); color: var(--paper); flex-direction: column; justify-content: center; gap: var(--space-6);
      opacity: 0; visibility: hidden; pointer-events: none; transition: opacity var(--dur-1) var(--ease), visibility 0s linear var(--dur-1); }
    .hdr__nav ul { flex-direction: column; align-items: center; font-family: var(--font-display); font-size: var(--step-2); }
    :global(.nav-open) .hdr__nav { opacity: 1; visibility: visible; pointer-events: auto; transition-delay: 0s; }
    :global(.nav-open) .hdr__toggle { color: var(--paper); }
    .hdr__toggle { position: relative; z-index: 2; }
  }
</style>
