---
import { Image } from 'astro:assets';
import { localizePath } from '../i18n/paths';
import type { Locale } from '../i18n/config';
import { createT } from '../i18n/t';
import type { LocalizedProduct } from '../lib/catalog';
interface Props { locale: Locale; product: LocalizedProduct; headingLevel?: 'h2' | 'h3' }
const { locale, product, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const href = localizePath(`/products/${product.slug}`, locale);
const alt = createT(locale)('alt.product', { name: product.text.name, origin: product.text.originLine });
---
<article class="pc" data-reveal>
  <a href={href} class="pc__link" title={product.text.seo.title}>
    <div class="pc__media">
      <Image src={product.data.heroImage.src} alt={alt} title={alt} widths={[360, 540, 720]} sizes="(max-width: 700px) 100vw, 33vw" quality={70} format="webp" loading="lazy" />
    </div>
    <H class="pc__title">{product.text.name}</H>
  </a>
  <p class="pc__origin">{product.text.originLine}</p>
</article>
<style>
  .pc { display: grid; gap: var(--space-3); align-content: start; }
  .pc__link { display: grid; gap: var(--space-3); text-decoration: none; }
  .pc__media { position: relative; overflow: hidden; border-radius: var(--radius-media); aspect-ratio: 4 / 3; background: var(--paper-2); }
  .pc__media { transition: transform 160ms var(--ease-out); }
  .pc__media :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 300ms var(--ease-out); }
  /* Zoom only for a real pointer (a tap would leave it stuck) and only when motion is welcome */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .pc__link:hover .pc__media :global(img) { transform: scale(1.03); }
    .pc__link:active .pc__media { transform: scale(0.98); }
  }
  .pc__title { font-size: var(--step-2); }
  .pc__origin { color: var(--ink-2); font-size: var(--step--1); }
</style>
