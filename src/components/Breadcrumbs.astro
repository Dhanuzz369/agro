---
import { localizePath } from '../i18n/paths';
import { createT } from '../i18n/t';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale; items: { name: string; path: string }[] }
const { locale, items } = Astro.props;
const t = createT(locale);
// Section crumbs get the same descriptive titles as the main menu; the rest use their own name.
const titles: Record<string, string> = { '/': t('link.home'), '/products': t('link.products'), '/blog': t('link.blog') };
---
<nav aria-label={t('breadcrumb.label')} class="crumbs">
  <ol>
    {items.map((i, idx) => (
      <li>{idx < items.length - 1 ? <a href={localizePath(i.path, locale)} title={titles[i.path] ?? i.name}>{i.name}</a> : <span aria-current="page">{i.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: 0; font-size: var(--step--1); }
  .crumbs li { display: flex; align-items: center; }
  /* A full-height touch target without changing how the trail looks */
  .crumbs a { display: inline-flex; align-items: center; min-block-size: 44px; }
  .crumbs li + li::before { content: '/'; margin-inline-end: var(--space-2); opacity: 0.5; }
</style>
