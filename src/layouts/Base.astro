---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import LanguageSuggestBanner from '../components/LanguageSuggestBanner.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { GA_ID, CONSENT_REGIONS, CONSENT_KEY } from '../lib/analytics';
import { htmlLang, isRtl, type Locale } from '../i18n/config';
import { createT } from '../i18n/t';
import { organizationLd } from '../lib/jsonld';
import { getSite } from '../lib/catalog';
import displayFont from '@fontsource/fraunces/files/fraunces-latin-300-normal.woff2?url';

interface Props {
  locale: Locale; title: string; description: string; path: string;
  available?: readonly Locale[]; ogImage?: string; ogImageAlt?: string; ogType?: 'website' | 'article';
  keywords?: readonly string[] | string; jsonLd?: object[]; noindex?: boolean; modified?: Date;
}
const { locale, jsonLd = [], ...seo } = Astro.props;
const t = createT(locale);
const site = await getSite();
const ld = [organizationLd(site, Astro.site!.href, t('meta.homeDescription')), ...jsonLd];
// Vercel serves /_vercel/* only on its own deployments; locally those paths 404 and log console errors.
const onVercel = Boolean(process.env.VERCEL);
// gtag.js loads on the live site only, so preview deploys and test runs never land in the GA4 reports.
const gaLive = process.env.VERCEL_ENV === 'production';
---
<!doctype html>
<html lang={htmlLang[locale]} dir={isRtl(locale) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1F3D2B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Noto Sans SC is ~700 KB of unicode-range slices for a zh page: fetch it after load so text paints at once in the
         system CJK font and swaps in, instead of every slice competing with the LCP. */}
    {/* The headline (home LCP) is Fraunces 300; fetch it with the HTML rather than after the CSS is parsed */}
    {!['ar', 'zh', 'ru'].includes(locale) && <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />}
    {locale === 'zh' && <script is:inline>addEventListener('load', () => { const l = document.createElement('link'); l.rel = 'stylesheet'; l.href = '/fonts/sc/400.css'; document.head.append(l); });</script>}
    {locale === 'zh' && <noscript><link rel="stylesheet" href="/fonts/sc/400.css" /></noscript>}
    <SeoHead locale={locale} jsonLd={ld} {...seo} />
    <slot name="head" />
    {/* Consent defaults must be queued before gtag.js runs; a saved choice is applied straight after them. */}
    <script is:inline define:vars={{ gaId: GA_ID, regions: CONSENT_REGIONS, key: CONSENT_KEY }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      const off = { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' };
      gtag('consent', 'default', { ...off, analytics_storage: 'denied', region: regions, wait_for_update: 500 });
      gtag('consent', 'default', { ...off, analytics_storage: 'granted' });
      try { const saved = localStorage.getItem(key); if (saved) gtag('consent', 'update', { analytics_storage: saved }); } catch {}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
    {gaLive && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
    {onVercel && <script is:inline defer src="/_vercel/insights/script.js"></script>}
    {onVercel && <script is:inline defer src="/_vercel/speed-insights/script.js"></script>}
  </head>
  <body>
    <a class="skip" href="#main" title={t('nav.skip')}>{t('nav.skip')}</a>
    <Header locale={locale} path={seo.path} />
    <main id="main"><slot /></main>
    <Footer locale={locale} path={seo.path} available={seo.available} />
    <WhatsAppButton locale={locale} />
    <LanguageSwitcher locale={locale} path={seo.path} available={seo.available} />
    <LanguageSuggestBanner locale={locale} path={seo.path} available={seo.available} />
    <ConsentBanner locale={locale} />
    <script>import '../scripts/motion';</script>
    <script>import '../scripts/analytics';</script>
  </body>
</html>
