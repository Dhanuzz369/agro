{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/index.html", "/products/turmeric/index.html", "/hsn/1701/index.html", "/blog/turmeric-hsn-codes-explained/index.html", "/ar/index.html"],
      "numberOfRuns": 2,
      "settings": { "formFactor": "mobile", "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75 } }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
      }
    }
  }
}
